{
  "version": 2,
  "builds": [{ "src": "**", "use": "@vercel/static" }],
  "headers": [
    {
      "source": "/tomato-pomodoro.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"tomato-pomodoro.apk\"" }
      ]
    }
  ]
}
